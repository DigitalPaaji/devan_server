enum ArticleStatus {
  DRAFT
  REJECTED
  PUBLISHED
}

model ExpertArticle { 
  id       Int @id @default(autoincrement())
  expertId Int @map("expert_id")

  title            String  @db.VarChar(250)
  slug             String  @unique @db.VarChar(300)
  shortDescription String? @map("short_description") @db.VarChar(500)
  content          Json

  thumbnail String?       @db.VarChar(500)
  category  String?       @db.VarChar(100)
  tags      String[]
  status    ArticleStatus @default(PUBLISHED)

  rejectionReason String? @map("rejection_reason") @db.VarChar(500)

  views Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expert Expert @relation("ExpertUploadedArticles", fields: [expertId], references: [id], onDelete: Cascade)

  @@index([expertId])
  @@index([status])
  @@map("expert_articles")
}
